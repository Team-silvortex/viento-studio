    "source": "extends Node\n\n@export var event_name: String = \"checkpoint\"\n@export var clip_id: String = \"\"\nvar _project\nvar _subscription: int = 0\n\nfunc _ready() -> void:\n\tif event_name.is_empty() or not has_meta(\"viento_project\"):\n\t\treturn\n\tvar project = get_meta(\"viento_project\")\n\tif not (project is Object) or not is_instance_valid(project):\n\t\treturn\n\tfor method in [\"subscribe_event\", \"unsubscribe_event\", \"select_animation_clip\", \"play_animation\"]:\n\t\tif not project.has_method(method):\n\t\t\treturn\n\t_project = project\n\t_subscription = _project.subscribe_event(event_name, _on_event)\n\nfunc _on_event(_value) -> bool:\n\tif _subscription == 0 or not (_project is Object) or not is_instance_valid(_project):\n\t\treturn false\n\tvar selection = null if clip_id.is_empty() else clip_id\n\tif not _project.select_animation_clip(selection):\n\t\treturn false\n\treturn _project.play_animation()\n\nfunc _exit_tree() -> void:\n\tvar project = _project\n\tvar subscription = _subscription\n\t_project = null\n\t_subscription = 0\n\tif subscription != 0 and project is Object and is_instance_valid(project) and project.has_method(\"unsubscribe_event\"):\n\t\tproject.unsubscribe_event(subscription)\n",
