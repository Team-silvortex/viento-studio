+.scene3d-distribution-dialog { width:min(1040px,calc(100vw - 24px)); max-width:1040px; max-height:calc(100dvh - 24px); margin:auto; padding:20px; box-sizing:border-box; overflow:auto; border:1px solid #33536a; border-radius:16px; color:#d8e9f8; background:#101c2b; }
+.scene3d-distribution-dialog::backdrop { background:rgba(2,8,18,.76); }
+.scene3d-distribution-dialog [hidden] { display:none!important; }
+.scene3d-distribution-header { display:flex; align-items:center; justify-content:space-between; gap:12px; }
+.scene3d-distribution-header h2 { margin:0; font-size:1.3rem; }
+.scene3d-distribution-note,.scene3d-distribution-objects code { color:#a1bbcf; font-size:.88rem; overflow-wrap:anywhere; }
+.scene3d-distribution-diagnostic { color:#ffcaab; overflow-wrap:anywhere; }
+.scene3d-distribution-search { display:grid; gap:8px; }
+.scene3d-distribution-dialog input[type=search],.scene3d-distribution-dialog select { width:100%; min-width:0; box-sizing:border-box; padding:9px; border:1px solid #33536a; border-radius:6px; background:#0a1422; color:inherit; font:inherit; }
+.scene3d-distribution-selection-controls { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
+.scene3d-distribution-selection-controls p { flex:1 1 100%; font-size:.88rem; overflow-wrap:anywhere; }
+.scene3d-distribution-objects { margin:12px 0; padding:0; list-style:none; max-height:240px; overflow:auto; }
+.scene3d-distribution-objects li { padding:9px; border:1px solid #33536a; border-radius:6px; margin-bottom:8px; background:#0a1422; }
+.scene3d-distribution-objects label { display:flex; align-items:start; gap:8px; overflow-wrap:anywhere; }
+.scene3d-distribution-objects label span { min-width:0; white-space:pre-wrap; }
+.scene3d-distribution-objects input { flex:0 0 auto; }
+.scene3d-distribution-objects code { display:block; margin-top:5px; font-size:.75rem; }
+.scene3d-distribution-axis { min-width:0; margin:0; padding:12px; border:1px solid #33536a; border-radius:8px; }
+.scene3d-distribution-axis label { display:grid; gap:6px; max-width:280px; }
+
+.scene3d-distribution-comparison { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
+.scene3d-distribution-comparison section { min-width:0; }
+.scene3d-distribution-dialog pre { margin:8px 0; padding:10px; border:1px solid #33536a; border-radius:6px; color:#bdd1e4; background:#0a1422; white-space:pre-wrap; overflow-wrap:anywhere; font-size:.8rem; }
+.scene3d-distribution-dialog li { overflow-wrap:anywhere; }
+.scene3d-distribution-footer { position:sticky; bottom:-20px; display:flex; flex-wrap:wrap; justify-content:flex-end; gap:10px; margin-top:18px; padding:14px 0; border-top:1px solid #33536a; background:#101c2b; }
