+
+.scene3d-distribution-ordered { padding-left:24px; }
+.scene3d-distribution-ordered li { margin:8px 0; padding:8px; border:1px solid #33536a; border-radius:6px; background:#0a1422; }
+.scene3d-distribution-ordered span,.scene3d-distribution-ordered code { display:block; white-space:pre-wrap; overflow-wrap:anywhere; }
+.scene3d-distribution-ordered code { color:#a1bbcf; font-size:.75rem; }
