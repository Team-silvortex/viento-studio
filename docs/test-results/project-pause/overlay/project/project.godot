config_version=5
[application]
config/name="Pause overlay long-text probe"
run/main_scene="res://probe.tscn"
[display]
window/size/viewport_width=390
window/size/viewport_height=300
window/size/window_width_override=390
window/size/window_height_override=300
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.9, 0.02, 0.8, 1)
