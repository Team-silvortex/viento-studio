\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"缩小\" disabled=\"\">缩小</button>\n    <output id=\"scenePreviewZoom\" aria-live=\"off\"></output>\n    <button id=\"scenePreviewZoomIn\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"放大\" disabled=\"\">放大</button>\n    <label class=\"scene-preview-grid\"><input id=\"scenePreviewGrid\" type=\"checkbox\" disabled=\"\"><span data-i18n=\"显示网格\">显示网格</span></label></div>\n    <p id=\"scenePreviewMessage\" role=\"status\" aria-live=\"polite\">请选择场景以查看预览。</p>\n    <p id=\"scenePreviewProvenance\" class=\"build-hint\"></p>\n    <p id=\"scenePreviewSummary\" class=\"build-hint\"></p>\n    <p id=\"scenePreviewComposition\" class=\"build-hint\" hidden=\"\">配方预览（只读） · 该预览由配方展开生成；请编辑配方原文以修改布局。</p><div id=\"scenePreviewSceneSources\" class=\"scene-preview-toolbar\" hidden=\"\"></div>\n    <p class=\"build-hint\" id=\"scenePreviewHelp\" data-i18n=\"点击角色查看属性；拖动画布平移，滚轮缩放。画布聚焦后可用方向键平移、加减键缩放、0 适应画布。\" hidden=\"\">点击角色查看属性；拖动画布平移，滚轮缩放。画布聚焦后可用方向键平移、加减键缩放、0 适应画布。</p>\n    <div class=\"scene-preview-layout\"><canvas id=\"scenePreviewCanvas\" tabindex=\"0\" aria-describedby=\"scenePreviewHelp\" data-i18n-aria-label=\"已保存的二维场景预览\" aria-label=\"已保存的二维场景预览\" hidden=\"\"></canvas>\n    <aside><h3 data-i18n=\"场景对象\">场景对象</h3><label class=\"scene-field\"><span data-i18n=\"搜索场景对象与分组\">搜索场景对象与分组</span><input id=\"scenePreviewSearch\" type=\"search\"></label><ol id=\"scenePreviewObjects\"><li class=\"build-hint\">没有匹配的场景对象或分组。</li></ol><p id=\"scenePreviewSelection\" role=\"status\" aria-live=\"polite\">从画布或对象列表选择角色。</p>\n    <section id=\"scenePreviewInspector\" aria-labelledby=\"scenePreviewInspectorTitle\" hidden=\"\"><h3 id=\"scenePreviewInspectorTitle\" data-i18n=\"对象属性\">对象属性</h3><div id=\"scenePreviewProperties\"></div><button id=\"scenePreviewCompositionOverride\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"编辑此实例覆盖\" disabled=\"\">编辑此实例覆盖</button><button id=\"scenePreviewCompositionLayout\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"调整此实例布局\" disabled=\"\">调整此实例布局</button><button id=\"scenePreviewCompositionFragment\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"编辑共享片段\" disabled=\"\">编辑共享片段</button><button id=\"scenePreviewCompositionPlacement\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"调整整组偏移\" disabled=\"\">调整整组偏移</button><p id=\"scenePreviewCompositionOverrideHint\" class=\"build-hint\" hidden=\"\">请先在源码模式打开同一配方，再编辑此实例覆盖。</p></section></aside></div>\n    <div class=\"scene-preview-toolbar\"><button id=\"scenePreviewCompositionDefinitions\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"管理片段定义\" disabled=\"\">管理片段定义</button><button id=\"scenePreviewCompositionGroups\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"编辑组织分组\" disabled=\"\">编辑组织分组</button><button id=\"scenePreviewCompositionPlacements\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"管理片段放置\" disabled=\"\">管理片段放置</button><button id=\"scenePreviewCompositionStructure\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"编辑片段结构\" disabled=\"\">编辑片段结构</button><button id=\"scenePreviewCompositionBatchLayout\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"调整配方布局\" disabled=\"\">调整配方布局</button><button id=\"scenePreviewDraftLayoutEdit\" type=\"button\" class=\"doc-btn\" hidden=\"\" data-i18n=\"调整草稿布局\" disabled=\"\">调整草稿布局</button><button id=\"scenePreviewLayoutEdit\" type=\"button\" class=\"doc-btn\" data-i18n=\"编辑场景布局\" hidden=\"\" disabled=\"\">编辑场景布局</button><button id=\"scenePreviewEdit\" type=\"button\" class=\"doc-btn\" data-i18n=\"编辑场景\" disabled=\"\">编辑场景</button>\n    <button id=\"scenePreviewSource\" type=\"button\" class=\"doc-btn doc-btn-ghost\" disabled=\"\">打开场景原文</button></div>\n    <ul id=\"scenePreviewDiagnostics\" class=\"scene-diagnostics\"></ul></section>\n    <section id=\"projectBuildTaskPanel\" role=\"tabpanel\" aria-labelledby=\"projectBuildTabBuild\">\n    <div class=\"build-actions\"><button id=\"projectBuildPlan\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"检查计划\">检查计划</button>\n    <button id=\"projectBuildGenerate\" type=\"button\" class=\"doc-btn\" data-i18n=\"构建场景\" disabled=\"\">构建场景</button>\n    <button id=\"projectBuildHeadless\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"无头测试\" disabled=\"\">无头测试</button>\n    <button id=\"projectBuildControl\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"控制回放\" disabled=\"\">控制回放</button>\n    <button id=\"projectBuildCaseRun\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"运行验收\" disabled=\"\">运行验收</button>\n    <button id=\"projectBuildWindow\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"窗口预览\" disabled=\"\">窗口预览</button>\n    <button id=\"projectBuildCancel\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"取消任务\" hidden=\"\">取消任务</button></div>\n    <details id=\"projectBuildControlEditor\" class=\"build-control-editor\"><summary data-i18n=\"编辑控制回放\">编辑控制回放</summary>\n    <p class=\"build-hint\" data-i18n=\"方向键按固定步长逐步回放；仅用于本次无头测试，不写入作品文件。\">方向键按固定步长逐步回放；仅用于本次无头测试，不写入作品文件。</p>\n    <div class=\"build-control-target\"><label for=\"projectBuildControlTarget\" data-i18n=\"输入示例的目标\">输入示例的目标</label><select id=\"projectBuildControlTarget\" data-targets=\"[&quot;&quot;,[],&quot;全部方向键实例（全局）&quot;]\" disabled=\"\"><option class=\"\" value=\"\">全部方向键实例（全局）</option></select>\n    <button id=\"projectBuildControlExample\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"生成输入示例\" disabled=\"\">生成输入示例</button></div>\n    <p id=\"projectBuildControlTargetHint\" class=\"build-hint\" hidden=\"\" data-i18n=\"实例输入按步骤独立生效；某一步未列出的实例会释放方向键，不延续上一步输入。\">实例输入按步骤独立生效；某一步未列出的实例会释放方向键，不延续上一步输入。</p>\n    <label for=\"projectBuildControlProgram\" data-i18n=\"控制步骤（JSON）\">控制步骤（JSON）</label><textarea id=\"projectBuildControlProgram\" spellcheck=\"false\" maxlength=\"262144\" rows=\"9\" aria-describedby=\"projectBuildControlBudget projectBuildControlError\"></textarea>\n    <p id=\"projectBuildControlBudget\" class=\"build-hint\">4 步 · 每步 0.25 秒 · 共 1 秒</p><p id=\"projectBuildControlError\" role=\"alert\" hidden=\"\"></p></details>\n    <details id=\"projectBuildCaseEditor\" class=\"build-control-editor\"><summary data-i18n=\"编辑运行验收\">编辑运行验收</summary>\n    <p class=\"build-hint\" data-i18n=\"按实例和步骤检查位置或状态；运行使用冻结构建，保存用例需明确操作。执行完成与验收通过分别显示。\">按实例和步骤检查位置或状态；运行使用冻结构建，保存用例需明确操作。执行完成与验收通过分别显示。</p>\n    <div id=\"projectBuildCaseDocuments\"><div class=\"build-case-documents\"><h4 data-i18n=\"工程验收用例\">工程验收用例</h4>\n    <p class=\"build-hint\" data-i18n=\"用例保存到工程正文，可随工程或资源包迁移。载入不会改动控制回放文本。\">用例保存到工程正文，可随工程或资源包迁移。载入不会改动控制回放文本。</p>\n    <div class=\"build-case-document-picker\"><label for=\"projectBuildCaseDocumentSelect\" data-i18n=\"已保存用例\">已保存用例</label>\n    <select id=\"projectBuildCaseDocumentSelect\" data-signature=\"[[],&quot;&quot;,&quot;请先刷新用例列表&quot;,&quot;暂无已保存用例&quot;,&quot;需要修复&quot;]\" disabled=\"\"><option value=\"\">请先刷新用例列表</option></select>\n    <button id=\"projectBuildCaseDocumentRefresh\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"刷新用例\" disabled=\"\">刷新用例</button>\n    <button id=\"projectBuildCaseDocumentLoad\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"载入用例\" disabled=\"\">载入用例</button></div>\n    <div class=\"build-case-document-fields\"><label for=\"projectBuildCaseDocumentPath\" data-i18n=\"用例保存位置\">用例保存位置</label>\n    <input id=\"projectBuildCaseDocumentPath\" type=\"text\" maxlength=\"2048\" autocomplete=\"off\">\n    <label for=\"projectBuildCaseDocumentType\" data-i18n=\"用例文档类型\">用例文档类型</label><select id=\"projectBuildCaseDocumentType\" data-signature=\"[]\"></select></div>\n    <div class=\"build-actions\"><button id=\"projectBuildCaseDocumentSave\" type=\"button\" class=\"doc-btn\" data-i18n=\"保存用例\" disabled=\"\">保存用例</button>\n    <button id=\"projectBuildCaseDocumentSaveAs\" type=\"button\" class=\"doc-btn doc-btn-ghost\" data-i18n=\"用例另存为\" disabled=\"\"