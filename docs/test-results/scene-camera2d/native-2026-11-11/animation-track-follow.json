  "scope": "Additional standalone native smoke without changes to frozen production or tests",
  "source": "extends \"res://camera2d-project-runtime.gd\"\nfunc snap(label: String) -> void:\n\tvar actor = current.actors[1].node\n\tvar visual = actor.get_child(0)\n\tvar camera = current.get_node(\"VientoCamera2D\").camera\n\tcamera.force_update_scroll()\n\tvar center = camera.get_screen_center_position()\n\tprint(\"VIENTO_ANIMATION_CAMERA:\"+JSON.stringify({\"label\":label,\"logical\":[actor.position.x,actor.position.y],\"visualName\":str(visual.name),\"visualOffset\":[visual.position.x,visual.position.y],\"center\":[center.x,center.y],\"cameraParent\":str(camera.get_parent().name),\"time\":current.animation_time}))\n\tawait RenderingServer.frame_post_draw\n\tget_viewport().get_texture().get_image().save_png(\"/home/chiharukiryu/cdev/viento-studio/docs/test-results/scene-camera2d/native-2026-11-11\"+\"/animation-\"+label+\".png\")\nfunc run_project_smoke() -> void:\n\tawait get_tree().process_frame\n\tawait snap(\"before\")\n\telapsed_seconds += 0.5\n\ttotal_seconds += 0.5\n\tcurrent.project_step(0.5)\n\tawait get_tree().process_frame\n\tawait snap(\"after\")\n\tfinish_project()\n",
