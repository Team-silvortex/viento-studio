          "content": "{\n  \"format\": \"viento-scene2d\",\n  \"schemaVersion\": 2,\n  \"title\": \"Checkpoint sound scene\",\n  \"viewport\": [\n    800,\n    480\n  ],\n  \"background\": \"#152f2a\",\n  \"actors\": [\n    {\n      \"instanceId\": \"b34e5840-ff4d-4da8-b8ac-8af4ab963c15\",\n      \"objectId\": \"e3e6bde0-1aa8-47dd-9809-db6cf51367a9\",\n      \"position\": [\n        200,\n        220\n      ],\n      \"size\": [\n        80,\n        80\n      ],\n      \"color\": \"#ffffff\",\n      \"speed\": 0,\n      \"controls\": \"none\"\n    }\n  ]\n}\n",
          "sourceRevision": "sha256:e0c8918cc08dd8fd95eaea3598ddaa61b82c60590e76dbdd42d185ae9c338a78"
