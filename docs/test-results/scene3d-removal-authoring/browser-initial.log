{
  "startedAt": "2026-10-12T08:13:51.515Z",
  "steps": [
    {
      "name": "default-cancel",
      "detail": "The real 17-module/33-capability editor mounts a ninth native author domain with no preselected IDs and no approval. Cancel leaves draft and disk untouched. Literal authored names render as text. Actual WebGL2 readPixels, renderer, vendor and error are recorded; a software implementation is explicitly identified by those fields."
    },
    {
      "name": "runs-and-locales",
      "detail": "Reverse-click first, middle, tail, contiguous-middle and alternating selections review source-order removed objects, every survivor and original /objects/i paths. A complete independently reconstructed cut matches native bytes, including BOM, CRLF, escaped key and Unicode. Three 390px languages retain the approved full candidate, hidden selections and usable sticky footer without horizontal overflow."
    },
    {
      "name": "full-selection-refusal",
      "detail": "Select-current-results retains all six selected identities across filtering. Both Check and Apply remain blocked with a one-survivor explanation; no automatic identity truncation occurs. Clearing restores empty selection."
    },
    {
      "name": "127-of-128-and-singleton",
      "detail": "A real 128-object draft first refuses full selection. Deselecting one keeps 127 source IDs and reviews one exact surviving declaration with 127 original paths. Apply changes memory only. Reopening that actual one-object candidate refuses its final removal and leaves disk unchanged."
    },
    {
      "name": "apply-save-and-manual-preview-refresh",
      "detail": "Actual author Apply accepts the current private proposal and updates only source memory. The already-open readonly preview preserves its old selection and disables Locate while stale. Manual Refresh loads three source-order survivors and falls back from a removed selection to the first survivor, with actual WebGL draws. Ordinary Save then persists exact reviewed bytes, and reopened removal starts empty with three persisted objects."
    },
    {
      "name": "raw-intent-source-and-private-brand-guards",
      "detail": "Silent checkbox/query edits revoke Apply. Actual source changes with and without input cannot be overwritten by stale approval. Closed-session and detached filtered rows do not change current selection. Actual WASM-backed pure proposals retain the ninth private brand: serialized clones and both old-copy/removal application directions reject cross-domain authority."
    },
    {
      "name": "ordinary-save-conflict",
      "detail": "External disk modification triggers the existing ordinary Save conflict dialog after a valid removal draft. Cancel preserves external bytes and the unsaved reviewed candidate independently; removal cannot bypass disk preconditions."
    },
    {
      "name": "native-ui-without-webgl",
      "detail": "The only injected unavailability is WebGL2 drawing. Readonly preview reports its fallback, while the real native removal interface still produces a complete two-survivor review. Cancel leaves the externally saved source intact."
    }
  ],
