+.scene3d-removal-dialog input[type=search] { width:100%; min-width:0; box-sizing:border-box; padding:9px; border:1px solid #33536a; border-radius:6px; background:#0a1422; color:inherit; font:inherit; }
+.scene3d-removal-selection-controls { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
+.scene3d-removal-selection-controls p { flex:1 1 100%; font-size:.88rem; overflow-wrap:anywhere; }
+.scene3d-removal-objects { margin:12px 0; padding:0; list-style:none; max-height:240px; overflow:auto; }
+.scene3d-removal-objects li { padding:9px; border:1px solid #33536a; border-radius:6px; margin-bottom:8px; background:#0a1422; }
+.scene3d-removal-objects label { display:flex; align-items:start; gap:8px; overflow-wrap:anywhere; }
+.scene3d-removal-objects label span { min-width:0; white-space:pre-wrap; }
+.scene3d-removal-objects input { flex:0 0 auto; }
+.scene3d-removal-objects code { display:block; margin-top:5px; font-size:.75rem; }
+.scene3d-removal-comparison { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
+.scene3d-removal-comparison section { min-width:0; }
+.scene3d-removal-dialog pre { margin:8px 0; padding:10px; border:1px solid #33536a; border-radius:6px; color:#bdd1e4; background:#0a1422; white-space:pre-wrap; overflow-wrap:anywhere; font-size:.8rem; }
+.scene3d-removal-dialog li { overflow-wrap:anywhere; }
+.scene3d-removal-footer { position:sticky; bottom:-20px; display:flex; flex-wrap:wrap; justify-content:flex-end; gap:10px; margin-top:18px; padding:14px 0; border-top:1px solid #33536a; background:#101c2b; }
+@media(max-width:700px) { .scene3d-removal-dialog { padding:14px; } .scene3d-removal-header h2 { font-size:1.1rem; } .scene3d-removal-comparison { grid-template-columns:minmax(0,1fr); gap:4px; } .scene3d-removal-footer { bottom:-14px; } }
