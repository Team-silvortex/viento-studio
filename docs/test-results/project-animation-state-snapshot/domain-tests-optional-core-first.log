script {\"format\":\"viento-animation-state-script\",\"schemaVersion\":1,\"generator\":\"godot-gdscript-v1\",\"table\":{\"initialState\":\"idle\",\"states\":[{\"key\":\"idle\"},{\"key\":\"action\"}],\"transitions\":[{\"from\":\"idle\",\"to\":\"action\",\"trigger\":{\"kind\":\"event\",\"name\":\"action\"}},{\"from\":\"action\",\"to\":\"idle\",\"trigger\":{\"kind\":\"completed\"}}]}}\nextends Node\n\n# One controller owns the current scene's animation playhead.\n# Empty clip parameters select the whole animation. Clip membership is checked\n# by the project port, not by this table. Explicit self-edges restart playback.\n@export var clip_idle: String = \"\"\n@export var clip_action: String = \"\"\nconst _INITIAL_STATE: int = 0\nconst _EVENT_NAMES: Array = [\"action\"]\nconst _TRANSITIONS: Array = [{\"fromIndex\":0,\"toIndex\":1,\"trigger\":{\"kind\":\"event\",\"name\":\"action\"}},{\"fromIndex\":1,\"toIndex\":0,\"trigger\":{\"kind\":\"completed\"}}]\nvar _project\nvar _event_subscriptions: Array = []\nvar _completion_subscription: int = 0\nvar _clips: Array = []\nvar _state: int = -1\nvar _selected_clip = null\nvar _active: bool = false\n\nfunc _port_valid(project) -> bool:\n\treturn typeof(project) == TYPE_OBJECT and is_instance_valid(project)\n\nfunc _ready() -> void:\n\tif not has_meta(\"viento_project\"):\n\t\treturn\n\tvar project = get_meta(\"viento_project\")\n\tif not _port_valid(project):\n\t\treturn\n\tfor method in [\"subscribe_event\", \"unsubscribe_event\", \"subscribe_animation_completed\", \"unsubscribe_animation_completed\", \"select_animation_clip\", \"play_animation\"]:\n\t\tif not project.has_method(method):\n\t\t\treturn\n\tvar clip_pattern := RegEx.new()\n\tclip_pattern.compile(\"^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$\")\n\tfor value in [clip_idle, clip_action]:\n\t\tvar matched = clip_pattern.search(value)\n\t\tif not value.is_empty() and (matched == null or matched.get_string() != value):\n\t\t\t_clips.clear()\n\t\t\tpush_error(\"Animation state clip parameters require a lowercase UUID or empty text.\")\n\t\t\treturn\n\t\t_clips.append(null if value.is_empty() else value)\n\t_project = project\n\tfor event_name in _EVENT_NAMES:\n\t\tvar token = _project.subscribe_event(event_name, _on_event.bind(event_name))\n\t\tif typeof(token) != TYPE_INT or token <= 0:\n\t\t\t_deactivate()\n\t\t\treturn\n\t\t_event_subscriptions.append(token)\n\tvar completion_token = _project.subscribe_animation_completed(_on_completed)\n\tif typeof(completion_token) != TYPE_INT or completion_token <= 0:\n\t\t_deactivate()\n\t\treturn\n\t_completion_subscription = completion_token\n\t_active = true\n\t_enter_state(_INITIAL_STATE)\n\nfunc _enter_state(next_state: int) -> bool:\n\tif not _active or not _port_valid(_project):\n\t\t_deactivate()\n\t\treturn false\n\tvar selection = _clips[next_state]\n\tif not _project.select_animation_clip(selection):\n\t\t_deactivate()\n\t\treturn false\n\tif not _project.play_animation():\n\t\t# Fail-stop only: a previously accepted select is not rolled back.\n\t\t_deactivate()\n\t\treturn false\n\t_state = next_state\n\t_selected_clip = selection\n\treturn true\n\nfunc _on_event(_value, event_name: String) -> bool:\n\tif not _active or not _port_valid(_project):\n\t\t_deactivate()\n\t\treturn false\n\tfor edge in _TRANSITIONS:\n\t\tif edge[\"fromIndex\"] == _state and edge[\"trigger\"][\"kind\"] == \"event\" and edge[\"trigger\"][\"name\"] == event_name:\n\t\t\treturn _enter_state(edge[\"toIndex\"])\n\treturn true\n\nfunc _on_completed(clip_id) -> bool:\n\tif not _active or not _port_valid(_project):\n\t\t_deactivate()\n\t\treturn false\n\tif clip_id != _selected_clip:\n\t\treturn true\n\tfor edge in _TRANSITIONS:\n\t\tif edge[\"fromIndex\"] == _state and edge[\"trigger\"][\"kind\"] == \"completed\":\n\t\t\treturn _enter_state(edge[\"toIndex\"])\n\treturn true\n\nfunc _deactivate() -> void:\n\tvar project = _project\n\tvar events = _event_subscriptions\n\tvar completion = _completion_subscription\n\t_project = null\n\t_event_subscriptions = []\n\t_completion_subscription = 0\n\t_active = false\n\t_state = -1\n\t_selected_clip = null\n\t_clips.clear()\n\tif not _port_valid(project):\n\t\treturn\n\tif project.has_method(\"unsubscribe_event\"):\n\t\tfor token in events:\n\t\t\tproject.unsubscribe_event(token)\n\tif completion != 0 and project.has_method(\"unsubscribe_animation_completed\"):\n\t\tproject.unsubscribe_animation_completed(completion)\n\nfunc _exit_tree() -> void:\n\t_deactivate()\n"}],"bindings":[{"bindingId":"00000008-1111-4111-8111-111111111111","instanceId":"11111111-1111-4111-8111-111111111111","objectId":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb","implementation":{"backendId":"org.viento.godot4","language":"gdscript","sourceObjectId":"00000007-1111-4111-8111-111111111111"},"parameters":{},"events":[{"signal":"arrived","event":"checkpoint"}],"declaration":{"objectId":"00000006-1111-4111-8111-111111111111","sourcePath":"documents/behaviors.json","sourceRevision":"sha256:67feedd86f2eaab89e85f0a7fa1fd5c7c0b7c4971c65809111f34d4ba493c922","propertyPath":"/bindings/0"}}]},"animation":{"format":"viento-animation-plan","schemaVersion":2,"manifest":{"objectId":"0000006e-1111-4111-8111-111111111111","sourcePath":"documents/animation-0.json","sourceRevision":"sha256:67feedd86f2eaab89e85f0a7fa1fd5c7c0b7c4971c65809111f34d4ba493c922"},"document":{"format":"viento-scene-animation","schemaVersion":3,"sceneObjectId":"dddddddd-dddd-4ddd-8ddd-dddddddddddd","durationSeconds":1,"loop":false,"tracks":[{"id":"00000078-1111-4111-8111-111111111111","instanceId":"11111111-1111-4111-8111-111111111111","property":"opacity","interpolation":"linear","keyframes":[{"atSeconds":0,"value":1},{"atSeconds":1,"value":0}]}],"clips":[{"id":"000000d2-1111-4111-8111-111111111111","name":"待机 / 待機 🌬️","startSeconds":0.2,"endSeconds":0.6,"loop":false},{"id":"000000d3-1111-4111-8111-111111111111","name":"Move","startSeconds":0.4,"endSeconds":1,"loop":true}]},"locations":{"tracks":[{"id":"00