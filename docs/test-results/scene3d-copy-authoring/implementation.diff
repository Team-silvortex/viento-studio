+        assert!(r.after_content.contains("1e3"));
+        let after = parsed(&r.after_content);
+        for i in 0..2 {
+            let mut expected = parsed(&source)["objects"][i].clone();
+            expected["instanceId"] = json!(id(i + 1001));
+            expected["position"][0] = json!(i + 2);
