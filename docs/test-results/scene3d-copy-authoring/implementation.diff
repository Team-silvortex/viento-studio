+.scene3d-copy-header h2 { margin:0; font-size:1.3rem; }
+.scene3d-copy-note,.scene3d-copy-objects code { color:#a1bbcf; font-size:.88rem; overflow-wrap:anywhere; }
+.scene3d-copy-diagnostic { color:#ffcaab; overflow-wrap:anywhere; }
