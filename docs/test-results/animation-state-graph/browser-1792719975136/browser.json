    "source": "# Viento animation state script\n#@viento-animation-state-script {\"format\":\"viento-animation-state-script\",\"schemaVersion\":1,\"generator\":\"godot-gdscript-v1\",\"table\":{\"initialState\":\"idle\",\"states\":[{\"key\":\"idle\"},{\"key\":\"attack\"},{\"key\":\"isolated\"}],\"transitions\":[{\"from\":\"idle\",\"to\":\"attack\",\"trigger\":{\"kind\":\"event\",\"name\":\"before-edit\"}},{\"from\":\"attack\",\"to\":\"idle\",\"trigger\":{\"kind\":\"completed\"}},{\"from\":\"attack\",\"to\":\"attack\",\"trigger\":{\"kind\":\"event\",\"name\":\"again\"}},{\"from\":\"idle\",\"to\":\"attack\",\"trigger\":{\"kind\":\"event\",\"name\":\"alternate\"}},{\"from\":\"idle\",\"to\":\"attack\",\"trigger\":{\"kind\":\"completed\"}}]}}\nextends Node\n\n# One controller owns the current scene's animation playhead.\n# Empty clip parameters select the whole animation. Clip membership is checked\n# by the project port, not by this table. Explicit self-edges restart playback.\n@export var clip_idle: String = \"\"\n@export var clip_attack: String = \"\"\n@export var clip_isolated: String = \"\"\nconst _INITIAL_STATE: int = 0\nconst _EVENT_NAMES: Array = [\"before-edit\",\"again\",\"alternate\"]\nconst _TRANSITIONS: Array = [{\"fromIndex\":0,\"toIndex\":1,\"trigger\":{\"kind\":\"event\",\"name\":\"before-edit\"}},{\"fromIndex\":1,\"toIndex\":0,\"trigger\":{\"kind\":\"completed\"}},{\"fromIndex\":1,\"toIndex\":1,\"trigger\":{\"kind\":\"event\",\"name\":\"again\"}},{\"fromIndex\":0,\"toIndex\":1,\"trigger\":{\"kind\":\"event\",\"name\":\"alternate\"}},{\"fromIndex\":0,\"toIndex\":1,\"trigger\":{\"kind\":\"completed\"}}]\nvar _project\nvar _event_subscriptions: Array = []\nvar _completion_subscription: int = 0\nvar _clips: Array = []\nvar _state: int = -1\nvar _selected_clip = null\nvar _active: bool = false\n\nfunc _port_valid(project) -> bool:\n\treturn typeof(project) == TYPE_OBJECT and is_instance_valid(project)\n\nfunc _ready() -> void:\n\tif not has_meta(\"viento_project\"):\n\t\treturn\n\tvar project = get_meta(\"viento_project\")\n\tif not _port_valid(project):\n\t\treturn\n\tfor method in [\"subscribe_event\", \"unsubscribe_event\", \"subscribe_animation_completed\", \"unsubscribe_animation_completed\", \"select_animation_clip\", \"play_animation\"]:\n\t\tif not project.has_method(method):\n\t\t\treturn\n\tvar clip_pattern := RegEx.new()\n\tclip_pattern.compile(\"^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$\")\n\tfor value in [clip_idle, clip_attack, clip_isolated]:\n\t\tvar matched = clip_pattern.search(value)\n\t\tif not value.is_empty() and (matched == null or matched.get_string() != value):\n\t\t\t_clips.clear()\n\t\t\tpush_error(\"Animation state clip parameters require a lowercase UUID or empty text.\")\n\t\t\treturn\n\t\t_clips.append(null if value.is_empty() else value)\n\t_project = project\n\tfor event_name in _EVENT_NAMES:\n\t\tvar token = _project.subscribe_event(event_name, _on_event.bind(event_name))\n\t\tif typeof(token) != TYPE_INT or token <= 0:\n\t\t\t_deactivate()\n\t\t\treturn\n\t\t_event_subscriptions.append(token)\n\tvar completion_token = _project.subscribe_animation_completed(_on_completed)\n\tif typeof(completion_token) != TYPE_INT or completion_token <= 0:\n\t\t_deactivate()\n\t\treturn\n\t_completion_subscription = completion_token\n\t_active = true\n\t_enter_state(_INITIAL_STATE)\n\nfunc _enter_state(next_state: int) -> bool:\n\tif not _active or not _port_valid(_project):\n\t\t_deactivate()\n\t\treturn false\n\tvar selection = _clips[next_state]\n\tif not _project.select_animation_clip(selection):\n\t\t_deactivate()\n\t\treturn false\n\tif not _project.play_animation():\n\t\t# Fail-stop only: a previously accepted select is not rolled back.\n\t\t_deactivate()\n\t\treturn false\n\t_state = next_state\n\t_selected_clip = selection\n\treturn true\n\nfunc _on_event(_value, event_name: String) -> bool:\n\tif not _active or not _port_valid(_project):\n\t\t_deactivate()\n\t\treturn false\n\tfor edge in _TRANSITIONS:\n\t\tif edge[\"fromIndex\"] == _state and edge[\"trigger\"][\"kind\"] == \"event\" and edge[\"trigger\"][\"name\"] == event_name:\n\t\t\treturn _enter_state(edge[\"toIndex\"])\n\treturn true\n\nfunc _on_completed(clip_id) -> bool:\n\tif not _active or not _port_valid(_project):\n\t\t_deactivate()\n\t\treturn false\n\tif clip_id != _selected_clip:\n\t\treturn true\n\tfor edge in _TRANSITIONS:\n\t\tif edge[\"fromIndex\"] == _state and edge[\"trigger\"][\"kind\"] == \"completed\":\n\t\t\treturn _enter_state(edge[\"toIndex\"])\n\treturn true\n\nfunc _deactivate() -> void:\n\tvar project = _project\n\tvar events = _event_subscriptions\n\tvar completion = _completion_subscription\n\t_project = null\n\t_event_subscriptions = []\n\t_completion_subscription = 0\n\t_active = false\n\t_state = -1\n\t_selected_clip = null\n\t_clips.clear()\n\tif not _port_valid(project):\n\t\treturn\n\tif project.has_method(\"unsubscribe_event\"):\n\t\tfor token in events:\n\t\t\tproject.unsubscribe_event(token)\n\tif completion != 0 and project.has_method(\"unsubscribe_animation_completed\"):\n\t\tproject.unsubscribe_animation_completed(completion)\n\nfunc _exit_tree() -> void:\n\t_deactivate()\n",
