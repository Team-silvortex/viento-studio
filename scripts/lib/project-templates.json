        "interface.yaml": "名称: 新建接口\n输入: []\n输出: []\n错误处理: \"\"\n",
        "workflow.md": "# 新建流程\n\n## 目标\n\n## 输入与前提\n\n## 步骤\n\n## 完成条件\n\n",
        "verification.yaml": "名称: 新建验证\n对象: \"\"\n前提: []\n步骤: []\n预期结果: \"\"\n"
      }
