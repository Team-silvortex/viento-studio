      "templates": {
        "document.md": "# 新建设计文档\n\n## 设计目标\n\n## 内容\n\n",
        "character.md": "# 新建角色\n\n## 基本信息\n名称：\n定位：\n所属阵营：\n\n## 外观与表现\n\n## 玩法与能力\n\n## 背景与经历\n\n## 关系\n\n",
        "ability.md": "# 新建能力\n\n## 基本信息\n名称：\n用途：\n\n## 发动条件\n\n## 效果与反馈\n\n## 消耗与限制\n\n## 关联角色与资源\n\n",
        "item.md": "# 新建道具\n\n## 基本信息\n名称：\n用途：\n\n## 获取与使用\n\n## 效果与限制\n\n## 外观与资源\n\n",
        "level.md": "# 新建关卡\n\n## 体验目标\n\n## 空间与环境\n\n## 进入条件\n\n## 流程与挑战\n\n## 完成与失败条件\n\n## 资源需求\n\n",
        "quest.md": "# 新建任务\n\n## 背景与目标\n\n## 触发条件\n\n## 流程与分支\n\n## 完成与失败条件\n\n## 奖励与后续影响\n\n",
        "faction.md": "# 新建阵营\n\n## 宗旨与立场\n\n## 成员与组织\n\n## 资源与势力范围\n\n## 历史与关系\n\n",
        "rule.md": "# 新建规则\n\n## 设计目的\n\n## 适用范围\n\n## 规则与边界\n\n## 示例与验证\n\n"
