{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viento.studio/schemas/scene3d-v1.schema.json",
  "title": "Viento primitive 3D scene v1",
  "description": "Experimental static box author representation. RH, Y up, -Z camera forward, Euler XYZ degrees; original text remains author authority. Camera/light nonparallel-up and clipping constraints are additionally enforced by the shared Rust core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "name",
    "viewport",
    "background",
    "camera",
    "light",
    "objects"
  ],
  "properties": {
    "format": {
      "const": "viento-scene3d"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "viewport": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8192
      }
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "fovDegrees",
        "near",
        "far"
      ],
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "target": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "fovDegrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 179
        },
        "near": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 10000
        },
        "far": {
          "type": "number",
          "minimum": 0.002,
          "maximum": 100000
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "color",
        "energy"
      ],
      "properties": {
        "direction": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000
          }
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "name",
          "primitive",
          "position",
          "rotationDegrees",
          "size",
          "color"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "primitive": {
            "const": "box"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          },
          "rotationDegrees": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -36000,
              "maximum": 36000
            }
          },
          "size": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 1000
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    }
  }
}
