{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "studio-profile-v1",
  "description": "Additive Studio capability requests. This data never grants write, execution, filesystem or module-loading permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "required",
    "optional"
  ],
  "properties": {
    "format": {
      "const": "viento-studio-profile"
    },
    "schemaVersion": {
      "const": 1
    },
    "required": {
      "$ref": "#/$defs/requests"
    },
    "optional": {
      "$ref": "#/$defs/requests"
    }
  },
  "$defs": {
    "requests": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "apiVersion"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "maxLength": 192,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "apiVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  }
}
